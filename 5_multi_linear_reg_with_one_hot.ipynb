   "source": [
    "from pandas.api.types import CategoricalDtype\n",
    "\n",
    "# Define ordered categories\n",
    "cut_order = CategoricalDtype(categories=['Fair', 'Good', 'Very Good', 'Premium', 'Ideal'], ordered=True)\n",
    "clarity_order = CategoricalDtype(categories=['I1', 'SI2', 'SI1', 'VS2', 'VS1', 'VVS2', 'VVS1', 'IF'], ordered=True)\n",
    "\n",
    "# Apply to DataFrame\n",
    "df['cut'] = df['cut'].astype(cut_order)\n",
    "df['clarity'] = df['clarity'].astype(clarity_order)\n",
    "\n",
    "# Now one-hot encode\n",
    "df_encoded = pd.get_dummies(df, columns=['cut', 'clarity'], prefix=['cut', 'clarity'])"
   ]
  },
